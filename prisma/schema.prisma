generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("UNSAIDBOX_DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  ARCHIVED
  SPAM
}

enum SharingPolicy {
  OWNER_MAY_SHARE
  PRIVATE_ONLY
}

model Administrator {
  id String @id @default(cuid()) @db.VarChar(30)
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(80)
  passwordHash String @db.VarChar(256)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AdministratorSession[]
  customerNotes AdministratorCustomerNote[]
}

model AdministratorSession {
  tokenHash String @id @db.VarChar(64)
  administratorId String @db.VarChar(30)
  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([administratorId])
}

model Account {
  id                 String        @id @default(cuid()) @db.VarChar(30)
  email              String        @unique @db.VarChar(254)
  emailVerifiedAt    DateTime?
  passwordHash       String        @db.VarChar(256)
  role               String        @default("USER") @db.VarChar(20)
  username           String        @unique @db.VarChar(30)
  displayName        String        @db.VarChar(80)
  introduction       String?       @db.VarChar(500)
  status             AccountStatus @default(PENDING)
  publicPageEnabled  Boolean       @default(false)
  inboxOpen          Boolean       @default(true)
  inboxSharingPolicy SharingPolicy @default(OWNER_MAY_SHARE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  questions          Question[]
  submissions        Submission[]
  sessions           Session[]
  tokens             AuthToken[]
  avatar             AccountAvatar?
  emailPreference    EmailPreference?
  emailDeliveries    EmailDelivery[]
  feedbackForms      FeedbackForm[]
  billingCustomers   BillingCustomer[]
  planUsage          PlanUsage[]
  brandSettings      BrandSettings?
  socialIdentities   SocialIdentity[]
  followups          FollowupConversation[]
  activity AccountActivity?
  exportPresets ExportPreset[]
  exportJobs ExportJob[]
  customerNotes AdministratorCustomerNote[]
  marketingConsent MarketingConsent?
  marketingEvents MarketingConsentEvent[]
}

model SocialIdentity {
  provider String @db.VarChar(20)
  subject String @db.VarChar(255)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([provider, subject])
  @@unique([accountId, provider])
}

model MarketingConsent {
  accountId String @id @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscribed Boolean @default(false)
  statement String @db.VarChar(500)
  version String @db.VarChar(40)
  source String @db.VarChar(30)
  chosenAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingConsentEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscribed Boolean
  statement String @db.VarChar(500)
  version String @db.VarChar(40)
  source String @db.VarChar(30)
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

// Serialize audience changes with campaign submission. Seeded by the migration.
model MarketingControl {
  id Int @id
  revision Int @default(0)
}

model MarketingLead {
  id String @id @default(cuid()) @db.VarChar(30)
  email String @unique @db.VarChar(254)
  firstName String @db.VarChar(80)
  subscribed Boolean @default(false)
  consentStatement String @db.VarChar(500)
  consentVersion String @db.VarChar(40)
  consentedAt DateTime
  requestedAt DateTime
  confirmedAt DateTime?
  withdrawnAt DateTime?
  tokenHash String? @unique @db.VarChar(64)
  tokenExpiresAt DateTime?
  events MarketingLeadEvent[]
}

model MarketingLeadEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  leadId String @db.VarChar(30)
  lead MarketingLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  choice String @db.VarChar(30)
  statement String @db.VarChar(500)
  version String @db.VarChar(40)
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
}

model MarketingCampaign {
  id String @id @default(cuid()) @db.VarChar(30)
  subject String @db.VarChar(200)
  heading String @db.VarChar(200)
  preheader String @db.VarChar(200)
  body String @db.Text
  status String @default("DRAFT") @db.VarChar(30)
  providerId Int? @unique
  recipientCount Int?
  createdBy String @db.VarChar(30)
  createdAt DateTime @default(now())
  submittedAt DateTime?
  @@index([createdAt])
}

model OAuthAttempt {
  tokenHash String @id @db.VarChar(64)
  browserHash String @db.VarChar(64)
  kind String @db.VarChar(20)
  payload Json
  expiresAt DateTime
  @@index([expiresAt])
}

model PlanUsage {
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month String @db.VarChar(96)
  submissions Int @default(0)
  updatedAt DateTime @updatedAt
  @@id([accountId, month])
}

model BrandSettings {
  accountId String @id @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name String @db.VarChar(60)
  accent String @db.VarChar(7)
  hideAttribution Boolean @default(false)
  logo Bytes? @db.Blob
  updatedAt DateTime @updatedAt
}

model EmailPreference {
  accountId String @id @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  newMessages Boolean @default(false)
  moderationReports Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model EmailDelivery {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(30)
  dedupeKey String @unique @db.VarChar(64)
  // AES-256-GCM encrypted; erased after acceptance, cancellation or expiry.
  payload String? @db.Text
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  sentAt DateTime?
  lastError String? @db.VarChar(40)
  @@index([status, nextAttemptAt])
  @@index([accountId, createdAt])
}

model AccountAvatar {
  accountId String @id @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  image Bytes @db.Blob
  version String @db.VarChar(32)
  updatedAt DateTime @updatedAt
}

model Question {
  id                  String        @id @default(cuid()) @db.VarChar(30)
  accountId           String        @db.VarChar(30)
  account             Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  body                String        @db.Text
  linkActive          Boolean       @default(true)
  acceptingResponses  Boolean       @default(true)
  publicVisible       Boolean       @default(false)
  discoverable        Boolean       @default(false)
  discoveryApproved   Boolean       @default(false)
  sharingPolicy       SharingPolicy @default(OWNER_MAY_SHARE)
  socialPostUrl       String?       @db.VarChar(1000)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  submissions         Submission[]

  @@unique([id, accountId])
  @@index([accountId, createdAt])
}

model Submission {
  id            String           @id @default(cuid()) @db.VarChar(30)
  accountId     String           @db.VarChar(30)
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  questionId    String?          @db.VarChar(30)
  question      Question?        @relation(fields: [questionId, accountId], references: [id, accountId], onDelete: Cascade)
  body          String           @db.Text
  ownerReply    String?          @db.Text
  publicBody    String?          @db.Text
  exportPermission ResponseExportPermission?
  status        SubmissionStatus @default(PENDING)
  publicVisible Boolean          @default(false)
  // Snapshot at submission: later settings must not loosen the sender's promise.
  sharingPolicy SharingPolicy    @default(OWNER_MAY_SHARE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  followup      FollowupConversation?

  @@index([accountId, status, createdAt])
  @@index([questionId, accountId, publicVisible])
}

model Session {
  tokenHash String @id @db.VarChar(64)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([accountId])
}

model AuthToken {
  tokenHash String @id @db.VarChar(64)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose String @db.VarChar(20)
  expiresAt DateTime
  @@index([accountId])
}

model RateLimit {
  key String @id @db.VarChar(64)
  count Int @default(1)
  expiresAt DateTime
}

model Report {
  id String @id @default(cuid()) @db.VarChar(30)
  questionId String? @db.VarChar(30)
  submissionId String? @db.VarChar(30)
  reason String @db.VarChar(1000)
  status String @default("OPEN") @db.VarChar(20)
  createdAt DateTime @default(now())
}

model AuditEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  actorId String @db.VarChar(30)
  action String @db.VarChar(80)
  targetId String @db.VarChar(30)
  createdAt DateTime @default(now())
}

// Desired catalogue prices only. Saving does not modify Stripe subscriptions.
model BillingConfiguration {
  id String @id @db.VarChar(30)
  prices Json
  revision Int @default(1)
  updatedBy String? @db.VarChar(30)
  updatedAt DateTime @updatedAt
}

model BillingCustomer {
  id String @id @db.VarChar(64)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  mode String @db.VarChar(10)
  stripeCustomerId String? @db.VarChar(255)
  lockToken String? @db.VarChar(64)
  lockUntil DateTime?
  checkoutKey String? @db.VarChar(64)
  checkoutParams Json?
  checkoutStartedAt DateTime?
  checkoutSessionId String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions BillingSubscription[]
  history BillingHistory[]
  @@unique([accountId, mode])
  @@unique([mode, stripeCustomerId])
}

model BillingPrice {
  id String @id @db.VarChar(64)
  mode String @db.VarChar(10)
  catalogRevision Int
  priceKey String @db.VarChar(30)
  stripePriceId String @db.VarChar(255)
  stripeProductId String @db.VarChar(255)
  amount Int
  currency String @db.VarChar(3)
  interval String @db.VarChar(10)
  createdAt DateTime @default(now())
  @@unique([mode, catalogRevision, priceKey])
  @@unique([mode, stripePriceId])
}

model BillingSubscription {
  id String @id @db.VarChar(255)
  customerId String @db.VarChar(64)
  customer BillingCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  mode String @db.VarChar(10)
  stripePriceId String @db.VarChar(255)
  status String @db.VarChar(30)
  recognized Boolean @default(false)
  cancelAtPeriodEnd Boolean @default(false)
  periodEnd DateTime?
  allowanceAnchor DateTime? @db.DateTime(3)
  paidThrough DateTime?
  syncedAt DateTime @default(now())
  @@index([customerId, mode])
}

model BillingEvent {
  id String @id @db.VarChar(255)
  mode String @db.VarChar(10)
  type String @db.VarChar(100)
  processedAt DateTime @default(now())
}

model BlogPost {
  id String @id @default(cuid()) @db.VarChar(30)
  slug String @unique @db.VarChar(160)
  title String @db.VarChar(180)
  excerpt String @db.VarChar(500)
  contentHtml String @db.MediumText
  authorName String @db.VarChar(100)
  category String @db.VarChar(80)
  seoTitle String @db.VarChar(180)
  seoDescription String @db.VarChar(320)
  imageAlt String @db.VarChar(300)
  // Publication is time-gated at every public query, including images and sitemap.
  published Boolean @default(false)
  publishAt DateTime?
  revision Int @default(1)
  imageLock String? @db.VarChar(64)
  imageLockedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image BlogImage?
  slugs BlogSlug[]
  @@index([published, publishAt])
}

model BlogSlug {
  slug String @id @db.VarChar(160)
  postId String @db.VarChar(30)
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
}

model BlogImage {
  postId String @id @db.VarChar(30)
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  image Bytes @db.MediumBlob
  version String @db.VarChar(32)
  cloudinaryPublicId String? @db.VarChar(255)
  cloudinaryUrl String? @db.VarChar(1000)
  updatedAt DateTime @updatedAt
}

model FeedbackForm {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  description String @db.VarChar(600)
  thankYou String @db.VarChar(300)
  templateId String @db.VarChar(40)
  questions Json
  theme String @default("lavender") @db.VarChar(20)
  allowSharing Boolean @default(false)
  // Once first published, the question schema and sharing promise are immutable.
  locked Boolean @default(false)
  linkActive Boolean @default(false)
  acceptingResponses Boolean @default(false)
  blocked Boolean @default(false)
  revision Int @default(1)
  responseCount Int @default(0)
  // Explicit form branding, never implicitly copied from a private profile photo.
  image Bytes? @db.Blob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries FeedbackEntry[]
  @@index([accountId, createdAt])
}

model FeedbackEntry {
  id String @id @default(cuid()) @db.VarChar(30)
  formId String @db.VarChar(30)
  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  requestKey String @db.VarChar(36)
  // Explicit optional sender consent, recorded independently on every submission.
  shareAllowed Boolean @default(false)
  createdAt DateTime @default(now())
  answers FeedbackAnswer[]
  review FeedbackEntryReview?
  exportPermission ResponseExportPermission?
  followup FollowupConversation?
  @@unique([formId, requestKey])
  @@index([formId, createdAt])
}

// Only token hashes are stored. Private replies never enter publication/export queries.
model FollowupConversation {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  submissionId String? @unique @db.VarChar(30)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  entryId String? @unique @db.VarChar(30)
  entry FeedbackEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.VarChar(64)
  closedAt DateTime?
  expiresAt DateTime
  messageCount Int @default(0)
  lastSenderAt DateTime?
  lastOwnerAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages FollowupMessage[]
  @@index([accountId, updatedAt])
}

model FollowupMessage {
  id String @id @default(cuid()) @db.VarChar(30)
  conversationId String @db.VarChar(30)
  conversation FollowupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author String @db.VarChar(10)
  body String @db.Text
  requestKey String @db.VarChar(36)
  createdAt DateTime @default(now())
  @@unique([conversationId, requestKey])
  @@index([conversationId, createdAt])
}

model FeedbackAnswer {
  id String @id @default(cuid()) @db.VarChar(30)
  entryId String @db.VarChar(30)
  entry FeedbackEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  questionId String @db.VarChar(50)
  label String @db.VarChar(240)
  type String @db.VarChar(10)
  textValue String? @db.Text
  numberValue Int?
  @@unique([entryId, questionId])
}

model AccountActivity {
  accountId String @id @db.VarChar(30)
  lastLoginAt DateTime? @db.DateTime(3)
  lastDashboardAt DateTime? @db.DateTime(3)
  firstQuestionAt DateTime? @db.DateTime(3)
  firstFormAt DateTime? @db.DateTime(3)
  firstResponseAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([lastDashboardAt])
}

model FeedbackEntryReview {
  entryId String @id @db.VarChar(30)
  status String @default("NEW") @db.VarChar(20)
  starred Boolean @default(false)
  tags Json?
  note String? @db.Text
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  entry FeedbackEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([status])
  @@index([starred])
}

model ExportPreset {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  name String @db.VarChar(100)
  source String @db.VarChar(20)
  purpose String @default("SHARING") @db.VarChar(20)
  format String @default("CSV") @db.VarChar(20)
  layout String @default("LONG") @db.VarChar(20)
  timezone String @default("UTC") @db.VarChar(64)
  filters Json
  columns Json
  schemaVersion Int @default(1)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId, updatedAt])
}

model ExportJob {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  requestKey String @db.VarChar(64)
  source String @db.VarChar(20)
  purpose String @default("SHARING") @db.VarChar(20)
  format String @default("CSV") @db.VarChar(20)
  layout String @default("LONG") @db.VarChar(20)
  timezone String @default("UTC") @db.VarChar(64)
  filters Json
  columns Json
  schemaVersion Int @default(1)
  policyVersion String @db.VarChar(40)
  status String @default("QUEUED") @db.VarChar(20)
  snapshotAt DateTime @default(now())
  checkpoint Json?
  matchingRecords Int?
  eligibleRecords Int?
  excludedRecords Int?
  processedRecords Int @default(0)
  outputRows Int @default(0)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockToken String? @db.VarChar(64)
  lockedUntil DateTime?
  lastErrorCode String? @db.VarChar(80)
  storageKey String? @db.VarChar(1000)
  fileName String? @db.VarChar(200)
  mimeType String? @db.VarChar(100)
  fileBytes BigInt?
  checksumSha256 String? @db.VarChar(64)
  startedAt DateTime?
  completedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  lastDownloadedAt DateTime?
  downloadCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, requestKey])
  @@index([accountId, createdAt])
  @@index([accountId, status])
  @@index([status, nextAttemptAt])
  @@index([lockedUntil])
  @@index([expiresAt])
}

// Exactly one target is required by the permission creation service.
// Missing rows must never grant analysis export permission.
model ResponseExportPermission {
  id String @id @default(cuid()) @db.VarChar(30)
  submissionId String? @unique @db.VarChar(30)
  entryId String? @unique @db.VarChar(30)
  noticeVersion String @db.VarChar(40)
  privateAnalysisAllowed Boolean @default(false)
  recordedAt DateTime @default(now())
  revokedAt DateTime?
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  entry FeedbackEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model AdministratorCustomerNote {
  id String @id @default(cuid()) @db.VarChar(30)
  accountId String @db.VarChar(30)
  administratorId String @db.VarChar(30)
  body String @db.Text
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Restrict)
  @@index([accountId, createdAt])
  @@index([administratorId])
}

model BillingHistory {
  id String @id @default(cuid()) @db.VarChar(30)
  customerId String @db.VarChar(64)
  mode String @db.VarChar(10)
  provider String @default("STRIPE") @db.VarChar(20)
  eventKey String @db.VarChar(255)
  eventType String @db.VarChar(100)
  objectId String? @db.VarChar(255)
  subscriptionId String? @db.VarChar(255)
  status String? @db.VarChar(40)
  currency String? @db.VarChar(3)
  amountPaid BigInt?
  amountRefunded BigInt?
  taxAmount BigInt?
  summary Json?
  occurredAt DateTime
  recordedAt DateTime @default(now())
  customer BillingCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  @@unique([provider, mode, eventKey])
  @@index([customerId, occurredAt])
  @@index([mode, eventType, occurredAt])
  @@index([subscriptionId])
}
