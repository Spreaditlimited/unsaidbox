# Dedicated database and restricted user on the existing MySQL server.
# Google reporting configuration (separate from Google sign-in).
# Local: set GOOGLE_APPLICATION_CREDENTIALS in .env.local to a private JSON file.
# Vercel: store the JSON contents as the server-only Secret below, never a public variable.
# Configuration only; reporting screens/jobs are not yet implemented.
GOOGLE_APPLICATION_CREDENTIALS=""
UNSAIDBOX_GOOGLE_SERVICE_ACCOUNT_JSON=""
UNSAIDBOX_SEARCH_CONSOLE_PROPERTY="sc-domain:unsaidbox.com"
UNSAIDBOX_GOOGLE_ADS_CUSTOMER_ID=""

# Never put the existing website's DATABASE_URL here.
# Prefer npm run db:configure: prompts privately and encodes the password.
# For a private CA, add sslcert pointing to its public certificate file.
UNSAIDBOX_DATABASE_URL="mysql://unsaidbox_app:URL_ENCODED_PASSWORD@YOUR_DB_SERVER:3306/unsaidbox?sslaccept=strict&connection_limit=3&connect_timeout=10&pool_timeout=10"

# Run npm run email:configure to save and verify these privately.
UNSAIDBOX_EMAIL_ENABLED="false"
UNSAIDBOX_APP_URL="http://localhost:3001"
UNSAIDBOX_SMTP_HOST="smtp.hostinger.com"
UNSAIDBOX_SMTP_PORT="465"
UNSAIDBOX_SMTP_USER="hello@unsaidbox.com"
# Password stored as base64 for safe dotenv parsing; base64 is NOT encryption.
UNSAIDBOX_SMTP_PASSWORD_B64=""
# Random 32-byte hex keys; server-only, never NEXT_PUBLIC_.
UNSAIDBOX_EMAIL_KEY=""
UNSAIDBOX_EMAIL_WORKER_SECRET=""
UNSAIDBOX_MAIL_PROVIDER="hostinger"
# Dedicated settings for this brand, even when the Brevo account is shared.
UNSAIDBOX_BREVO_API_KEY=""
UNSAIDBOX_BREVO_FOLDER_ID=""
UNSAIDBOX_BREVO_MARKETING_LIST_ID=""
UNSAIDBOX_MARKETING_ENABLED="false"
UNSAIDBOX_EMAIL_LEADS_ENABLED="false"
UNSAIDBOX_MARKETING_POSTAL_ADDRESS=""
UNSAIDBOX_EXPORT_WORKER_SECRET=""

# Public Google Analytics 4 measurement ID. Loaded only after visitor consent.
GOOGLE_ANALYTICS_TAG=""
# reCAPTCHA v3 score-based keys. Secret is server-only; site key is public.
GOOGLE_CAPTCHA_SITE_KEY=""
GOOGLE_CAPTCHA_SECRET_KEY=""
# The existing GOOGlE_CAPTCHA_SITE_KEY spelling is also supported.
# CAPTCHA automatically bypasses local development; production fails closed.
UNSAIDBOX_RECAPTCHA_HOSTNAMES="unsaidbox.com,www.unsaidbox.com"
UNSAIDBOX_RECAPTCHA_MIN_SCORE="0.5"

# Sandbox billing is opt-in; live mode is deliberately not enabled in this release.
UNSAID_BILLING_MODE="disabled"
UNSAID_STRIPE_TEST_SECRET_KEY=""
UNSAID_STRIPE_TEST_WEBHOOK_SECRET=""
# Reserved for a separately approved live launch; never used as a test fallback.
UNSAID_STRIPE_SECRET_KEY=""

# Server-only blog cover storage; namespace restricted to unsaidbox/blog.
UNSAIDBOX_CLOUDINARY_CLOUD_NAME=""
UNSAIDBOX_CLOUDINARY_API_KEY=""
UNSAIDBOX_CLOUDINARY_API_SECRET=""
